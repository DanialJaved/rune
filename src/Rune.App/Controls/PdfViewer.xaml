<UserControl
    x:Class="Rune.Controls.PdfViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <!-- ZoomMode carries pinch only; Ctrl+wheel is handled in code-behind so it
         never raster-scales. MinZoomFactor/MaxZoomFactor must match PdfViewer's
         MinZoom/MaxZoom: if the ScrollViewer clamps a pinch at a limit the real
         zoom hasn't reached, RebaseZoom folds in a factor the zoom can't absorb
         and the anchor drifts at the extremes. -->
    <ScrollViewer
        x:Name="Scroller"
        ZoomMode="Enabled"
        MinZoomFactor="0.1"
        MaxZoomFactor="6.4"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollMode="Enabled"
        VerticalScrollMode="Enabled"
        ViewChanged="Scroller_ViewChanged"
        SizeChanged="Scroller_SizeChanged">
        <win2d:CanvasVirtualControl
            x:Name="Canvas"
            RegionsInvalidated="Canvas_RegionsInvalidated"
            CreateResources="Canvas_CreateResources" />
    </ScrollViewer>
</UserControl>
